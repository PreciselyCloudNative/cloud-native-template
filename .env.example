# Precisely Cloud Native Template - Environment Variables

# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Precisely API Key (Required)
# Get your API key from: https://developer.cloud.precisely.com/
PRECISELY_API_KEY=your_api_key_here

# Server Port (optional, defaults to 3000)
PORT=3000

# Node Environment (development, production, test)
NODE_ENV=development

# ============================================
# Address Extraction Services (Optional)
# ============================================
# Enable AI-powered address extraction from natural language queries using GLiNER
#
# IMPORTANT: Set to 'true' ONLY if the AI Address Extraction service is running on port 5001
# Otherwise, keep 'false' - Natural Language Search will still work with regex fallback
#
# To check if the service is running: curl http://localhost:5001/api/v1/health
USE_LLM_EXTRACTION=false

# GLiNER Address Locator Microservice URL
# GLiNER is a specialized NER model specifically designed for address extraction
# The GLiNER service is a separate microservice at: ../ai-address-locator/
# To start the service: cd ../ai-address-locator && python run.py
# For local dev: use localhost:5001
# For Docker: use host.docker.internal:5001 (see .env.docker)
GLINER_SERVICE_URL=http://localhost:5001

# Add your custom environment variables below
# CUSTOM_VAR=value
