// Start server
app.listen(PORT, () => {
    console.log(`\n✅ Precisely Cloud Native Template Server running on http://localhost:${PORT}`);
    console.log(`📍 Autocomplete API: http://localhost:${PORT}/api/autocomplete`);
    console.log(`⚡ Express Autocomplete API: http://localhost:${PORT}/api/express-autocomplete`);
    console.log(`🤖 NLP Search API: http://localhost:${PORT}/api/nlp-search`);
    console.log(`🔗 Data Graph API: http://localhost:${PORT}/api/data-graph`);
    console.log(`🔒 API key is securely stored in environment variables`);
    console.log(`\n🌐 Open http://localhost:${PORT} in your browser\n`);
});
